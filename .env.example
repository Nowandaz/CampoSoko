# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# --- SMTP for app emails (wanted alerts, expiry reminders). ---
# The SAME credentials must also be entered in Supabase > Authentication > SMTP Settings
# so that sign-up/login OTP codes are sent through your SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampoSoko <no-reply@yourdomain.com>"

# --- Cron (protects /api/cron/* routes; any long random string) ---
CRON_SECRET=
