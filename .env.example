# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Use your real https URL in production (links in emails, receipts, QR codes and WhatsApp messages use it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# --- SMTP for app emails (wanted alerts, expiry reminders). ---
# Enter the SAME credentials in Supabase > Authentication > SMTP Settings so sign-up / reset codes use them too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampoSoko <no-reply@yourdomain.com>"

# --- Cron (protects /api/cron/expire; 16+ random characters). On Vercel, set the same value as an env var:
# Vercel Cron then sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=

# --- AI (optional) ---
# Provider API keys are added in the admin dashboard (Admin > AI) and stored encrypted in the database.
# Set a long random string here to be the encryption secret. If empty, one is derived from the service-role key
# (then rotating that key means re-entering your AI keys).
AI_KEYS_SECRET=
